style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #111;
    color: white;
}

header {
    padding: 22px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #191919;
}

.logo {
    color: #ff3b30;
    font-size: 27px;
    font-weight: bold;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
}

.hero {
    min-height: 500px;
    padding: 100px 8%;
    background: linear-gradient(90deg, #111, transparent),
    url('https://images.unsplash.com/photo-1571091718767-18b5b1457add?w=1600')
    center/cover;
}

.hero h1 {
    font-size: 55px;
    max-width: 500px;
}

.hero p {
    color: #ddd;
    margin-top: 20px;
    font-size: 18px;
}

.btn {
    display: inline-block;
    background: #ff3b30;
    padding: 15px 30px;
    color: white;
    text-decoration: none;
    border-radius: 7px;
    margin-top: 25px;
    border: none;
    cursor: pointer;
}

section {
    padding: 65px 8%;
}

h2 {
    font-size: 35px;
    margin-bottom: 30px;
}

.menu {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 25px;
}

.item {
    background: #202020;
    border-radius: 12px;
    overflow: hidden;
    padding-bottom: 20px;
}

.item img {
    width: 100%;
    height: 180px;
    object-fit: cover;
}

.item h3, .item p {
    margin: 15px;
}

.price {
    color: #ff453a;
    font-size: 22px;
    font-weight: bold;
}

.item button {
    margin-left: 15px;
    padding: 10px 20px;
    background: #ff3b30;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

.delivery {
    background: #1d1d1d;
    text-align: center;
    border-radius: 15px;
}

.delivery p {
    color: #ccc;
    margin-top: 15px;
    line-height: 1.7;
}

#cart {
    color: #ff453a;
    font-weight: bold;
}

footer {
    text-align: center;
    padding: 30px;
    background: #191919;
    color: #888;
}

@media(max-width:600px) {
    .hero h1 { font-size: 38px; }
    nav a { margin-left: 8px; font-size: 12px; }
}
