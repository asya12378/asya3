 {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
    scroll-behavior: smooth;
}

body {
    background: #080808;
    color: white;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25px 10%;
    background: #080808;
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid #222;
}

.logo {
    font-size: 25px;
    font-weight: bold;
    color: #b6ff65;
}

nav a {
    color: #ddd;
    text-decoration: none;
    margin-left: 25px;
    transition: .3s;
}

nav a:hover {
    color: #b6ff65;
}

.hero {
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 10%;
}

.hero span {
    color: #b6ff65;
    font-size: 18px;
}

.hero h1 {
    font-size: clamp(40px, 7vw, 75px);
    margin: 20px 0;
    max-width: 850px;
}

.hero p {
    color: #999;
    font-size: 19px;
    max-width: 550px;
    line-height: 1.7;
}

.btn {
    display: inline-block;
    width: fit-content;
    margin-top: 30px;
    padding: 15px 30px;
    background: #b6ff65;
    color: black;
    text-decoration: none;
    font-weight: bold;
    border-radius: 5px;
    transition: .3s;
}

.btn:hover {
    transform: translateY(-5px);
    background: white;
}

section {
    padding: 100px 10%;
}

.title {
    font-size: 38px;
    margin-bottom: 40px;
}

.title span {
    color: #b6ff65;
}

.about {
    background: #101010;
}

.about p {
    color: #aaa;
    line-height: 1.9;
    max-width: 750px;
    font-size: 18px;
}

.skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
}

.skill {
    padding: 30px;
    background: #151515;
    border: 1px solid #292929;
    border-radius: 10px;
    transition: .3s;
}

.skill:hover {
    border-color: #b6ff65;
    transform: translateY(-5px);
}

.skill h3 {
    color: #b6ff65;
    margin-bottom: 10px;
}

.skill p {
    color: #999;
}

.projects {
    background: #101010;
}

.project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 25px;
}

.project {
    background: #191919;
    border-radius: 10px;
    overflow: hidden;
    transition: .3s;
}

.project:hover {
    transform: translateY(-8px);
}

.project img {
    width: 100%;
    height: 200px;
    object-fit: cover;
}

.project-content {
    padding: 25px;
}

.project-content h3 {
    margin-bottom: 12px;
}

.project-content p {
    color: #999;
    line-height: 1.6;
}

.contact {
    text-align: center;
}

.contact p {
    color: #999;
    margin-top: 15px;
}

.contact a {
    color: #b6ff65;
    text-decoration: none;
}

footer {
    text-align: center;
    padding: 30px;
    background: #101010;
    color: #777;
    border-top: 1px solid #222;
}

.reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: 1s;
}

.reveal.active {
    opacity: 1;
    transform: translateY(0);
}

@media(max-width: 650px) {
    header {
        flex-direction: column;
        gap: 20px;
    }

    nav a {
        margin: 0 7px;
        font-size: 13px;
    }

    section {
        padding: 70px 7%;
    }
}
