
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #111;
    color: white;
    font-family: Arial, sans-serif;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25px 8%;
    background: #080808;
}

.logo {
    font-size: 28px;
    letter-spacing: 4px;
    font-weight: bold;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 25px;
}

.hero {
    min-height: 600px;
    background: linear-gradient(90deg, #111, transparent),
    url('https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=1600')
    center 30%/cover;
    display: flex;
    align-items: center;
    padding: 8%;
}

.hero h1 {
    font-size: 65px;
    letter-spacing: 5px;
}

.hero p {
    color: #ddd;
    margin-top: 20px;
    font-size: 18px;
}

.btn {
    display: inline-block;
    padding: 15px 30px;
    background: white;
    color: black;
    text-decoration: none;
    margin-top: 25px;
    font-weight: bold;
}

section {
    padding: 70px 8%;
}

h2 {
    font-size: 35px;
    margin-bottom: 35px;
    letter-spacing: 3px;
}

.models {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 25px;
}

.model {
    background: #1c1c1c;
    overflow: hidden;
}

.model img {
    width: 100%;
    height: 350px;
    object-fit: cover;
    transition: 0.4s;
}

.model img:hover {
    transform: scale(1.04);
}

.model h3 {
    padding: 15px;
    font-size: 21px;
}

.model p {
    padding: 0 15px 20px;
    color: #aaa;
}

.about {
    background: #1c1c1c;
    text-align: center;
    line-height: 1.8;
}

.about p {
    color: #ccc;
    max-width: 650px;
    margin: auto;
}

.contact {
    text-align: center;
}

input, textarea {
    width: 100%;
    max-width: 450px;
    padding: 15px;
    margin: 10px;
    background: #222;
    color: white;
    border: 1px solid #555;
}

button {
    padding: 15px 35px;
    background: white;
    border: none;
    cursor: pointer;
    font-weight: bold;
}

footer {
    padding: 30px;
    text-align: center;
    color: #888;
    background: #080808;
}

@media(max-width:600px) {
    .hero h1 {font-size: 40px;}
    nav a {margin-left: 8px; font-size: 12px;}
}
