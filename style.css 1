* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f5eee5;
    color: #382319;
}

header {
    background: #29180f;
    color: white;
    padding: 22px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

header h1 {
    letter-spacing: 3px;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
}

nav a:hover {
    color: #d6a46c;
}

.hero {
    height: 500px;
    background: linear-gradient(
        rgba(0,0,0,0.5),
        rgba(0,0,0,0.5)
    ), url("main-coffee.jpg") center/cover;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
}

.hero h2 {
    font-size: 48px;
    margin-bottom: 20px;
}

.hero p {
    font-size: 20px;
    margin-bottom: 30px;
}

.btn {
    display: inline-block;
    background: #a66b3f;
    color: white;
    padding: 14px 30px;
    text-decoration: none;
    border-radius: 5px;
    transition: 0.3s;
}

.btn:hover {
    background: #754323;
}

.menu {
    padding: 60px 8%;
    text-align: center;
}

.menu h2,
.about h2,
.contact h2 {
    font-size: 35px;
    margin-bottom: 35px;
}

.products {
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
}

.product {
    background: white;
    width: 280px;
    padding: 15px;
    border-radius: 12px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    transition: 0.3s;
}

.product:hover {
    transform: translateY(-8px);
}

.product img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 8px;
}

.product h3 {
    margin: 15px 0;
}

.product p {
    color: #777;
    margin-bottom: 12px;
}

.product h4 {
    color: #a66b3f;
    font-size: 22px;
}

.about {
    background: #e6d3bd;
    padding: 70px 15%;
    text-align: center;
}

.about p {
    font-size: 18px;
    line-height: 1.8;
}

.contact {
    padding: 70px 20px;
    text-align: center;
}

.contact p {
    margin-bottom: 25px;
}

footer {
    background: #29180f;
    color: white;
    text-align: center;
    padding: 25px;
}

@media (max-width: 700px) {
    header {
        flex-direction: column;
        gap: 20px;
    }

    nav a {
        margin: 5px;
        font-size: 13px;
    }

    .hero h2 {
        font-size: 32px;
    }
}
